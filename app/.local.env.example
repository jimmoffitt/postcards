# Copy this file to .local.env (in this app/ directory) and fill in your
# values. .local.env is gitignored -- never commit credentials.

# ---- @PostcardsFromHome ----
POSTCARDSFROMHOME_BSKY_HANDLE=athome-postcards.bsky.social
POSTCARDSFROMHOME_BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- @SomePostcards ----
SOMEPOSTCARDS_BSKY_HANDLE=somepostcards.bsky.social
SOMEPOSTCARDS_BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ---- Paths ----
# Where the feed photo folders live. Relative paths are resolved against
# this app/ directory, so ../photos means postcards/photos/.
PHOTOS_ROOT=../photos

# ---- Poster state ----
# Last-post times and the log of everything posted (the duplicate guard).
# Relative paths are resolved against this app/ directory.
STATE_DIR=state

# ---- Deploy (used by sync_to_pi.sh on the Mac) ----
DEPLOY_HOST=pi@raspberrypi.local
DEPLOY_DIR=/home/pi/projects/postcards

# ---- Logging ----
LOG_PATH=logs/poster.log
LOG_LEVEL=INFO

# ---- Curation web app ----
CURATE_HOST=127.0.0.1
CURATE_PORT=5001
